# Cloudflare

# Cloudflare API token.
# Get it from: Cloudflare Dashboard → My Profile → API Tokens
CF_API_TOKEN="your_cloudflare_api_token_here"

# Cloudflare Account ID.
# Get it from: Cloudflare Dashboard → Account Home → Copy Account ID from URL bar
CF_ACCOUNT_ID="your_cloudflare_account_id_here"

# Cloudflare IP List ID.
# Get it from: Cloudflare Dashboard → Account → Configurations → Lists
# Open the required IP List and copy the List ID from URL bar
CF_LIST_ID="your_cloudflare_list_id_here"


# Telegram

# Telegram bot token.
# Create a bot using @BotFather on Telegram and copy the token provided.
TG_BOT_TOKEN="your_telegram_bot_token_here"

# Telegram chat ID where automatic notifications should be sent.
# Send a message to the bot, then use a Telegram bot/API method to find the chat ID.
TG_CHAT_ID="your_telegram_chat_id_here"


# How often the bot checks the home IPv6 address, in seconds.
# 3600 = 60 minutes
CHECK_INTERVAL=3600


# Telegram user IDs allowed to use the bot.
# Get the user ID using a Telegram ID bot or from Telegram's API.
# Multiple user IDs can be separated by spaces.
ALLOWED_USERS="123456789 987654321"


# Comments used by the bot to identify its own Cloudflare List entries.
# These can be changed, but must remain unique within the list.
HOME_COMMENT="managed-home-ip"
CUSTOM_COMMENT="managed-custom-ip"
